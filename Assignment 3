# 1) Accepting the number from the user and display prime factors of that number
def unique_prime_factors(n):
    factors = set()
    divisor = 2
    while divisor <= n:
        while n % divisor == 0:
            factors.add(divisor)
            n = n // divisor
        divisor += 1
    return sorted(factors)

num = int(input("Enter a number: "))
print(f"Unique prime factors of {num}: {unique_prime_factors(num)}")

